/**
 * Tech Tank Hackathon: Google Apps Script web app.
 *
 * Serves every page of the website and the API those pages use:
 *   <web app URL>                 3D event website
 *   <web app URL>?page=register   create a participant account
 *   <web app URL>?page=login      participant sign in
 *   <web app URL>?page=portal     participant portal
 *   <web app URL>?page=admin      Control Room
 *
 * Data is kept in a private Google Drive folder ("Tech Tank Hackathon data") that setup() creates:
 * content.json (event content), participants.private.json (accounts and sessions),
 * payment-proofs/ (private screenshots), media/ (Control Room uploads, shared by link)
 * and a "Tech Tank registrations" spreadsheet for organisers.
 *
 * First time: run setup() once from the editor, copy the admin passcode from the execution log,
 * then Deploy > New deployment > Web app (Execute as: Me, Who has access: Anyone).
 *
 * The HTML files (Index, Account, Portal, Admin) and Seed.gs are generated by build-apps-script.js
 * from the website sources in public/. Edit those sources and rebuild instead of editing them here.
 */

var TT_POLL_MS = 5000;                       // how often open pages check for live updates
var TT_SESSION_MS = 7 * 24 * 60 * 60 * 1000; // participant sessions last seven days
var TT_MAX_PROOF = 5 * 1024 * 1024;          // payment screenshots
var TT_MAX_UPLOAD = 20 * 1024 * 1024;        // Control Room media uploads
var TT_HASH_ROUNDS = 2000;                   // PBKDF2-HMAC-SHA256 rounds for new passwords
var TT_CACHE_SECONDS = 21600;                // all writes go through this script, so caches stay current
var TT_STATUSES = ['registered', 'under-review', 'qualified', 'not-qualified', 'presenting', 'completed', 'disqualified'];
var TT_PAGES = {
  home: { file: 'Index', title: function (e) { return (e.name || 'Tech Tank Hackathon') + (e.theme ? ' · ' + e.theme : ''); } },
  register: { file: 'Account', title: function () { return 'Register · Tech Tank'; } },
  login: { file: 'Account', title: function () { return 'Sign in · Tech Tank'; } },
  portal: { file: 'Portal', title: function () { return 'Your portal · Tech Tank'; } },
  admin: { file: 'Admin', title: function () { return 'Tech Tank Control Room'; } },
};
var TT_PAGE_ALIASES = { '': 'home', index: 'home', account: 'login', signin: 'login', signup: 'register', controlroom: 'admin' };
var TT_UPLOAD_TYPES = {
  png: 'image/png', jpg: 'image/jpeg', jpeg: 'image/jpeg', gif: 'image/gif', webp: 'image/webp', avif: 'image/avif', svg: 'image/svg+xml',
  mp4: 'video/mp4', webm: 'video/webm', mov: 'video/quicktime', pdf: 'application/pdf',
};

/* ============================== pages ============================== */

function doGet(e) {
  var params = (e && e.parameter) || {};
  var requested = String(params.page || '').toLowerCase().replace(/[^a-z]/g, '');
  var page = TT_PAGE_ALIASES.hasOwnProperty(requested) ? TT_PAGE_ALIASES[requested] : requested;
  var def = TT_PAGES[page];
  var base = webAppUrl_();
  if (!def) {
    return HtmlService.createHtmlOutput('<!doctype html><meta charset="utf-8"><title>Page not found</title>'
      + '<body style="margin:0;min-height:100vh;display:grid;place-items:center;background:#04050a;color:#e9eef9;font:16px/1.6 system-ui,sans-serif;text-align:center">'
      + '<div><h1 style="margin:0 0 8px">Page not found</h1><p style="color:#8f99b3">This page does not exist on the Tech Tank website.</p>'
      + '<p><a href="' + escapeHtml_(base) + '" target="_top" style="color:#40d6ff">Open the Tech Tank website ↗</a></p></div></body>')
      .setTitle('Page not found · Tech Tank')
      .addMetaTag('viewport', 'width=device-width, initial-scale=1');
  }
  var raw = readContent_();
  var snapshot = publicSnapshot_(raw);
  var config = { base: base, page: page, pollMs: TT_POLL_MS, version: snapshot.version };
  // Public pages render immediately from this copy instead of waiting for a first request.
  if (page !== 'admin' && page !== 'portal') config.boot = snapshot.content;
  var html = HtmlService.createHtmlOutputFromFile(def.file).getContent();
  if (html.indexOf('__TT_CONFIG__') < 0) throw new Error(def.file + '.html is missing its configuration placeholder. Rebuild the Apps Script files.');
  // A replacer function keeps "$" characters in the content from being treated as patterns.
  html = html.replace('__TT_CONFIG__', function () { return scriptJson_(config); });
  return HtmlService.createHtmlOutput(html)
    .setTitle(def.title(raw.event || {}) || 'Tech Tank')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1, viewport-fit=cover')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.DEFAULT);
}

function webAppUrl_() {
  var url = props_().getProperty('WEB_APP_URL');
  if (url) return url;
  try { url = ScriptApp.getService().getUrl(); } catch (err) { url = ''; }
  return url || '';
}

/* ============================== one-time setup ============================== */

/**
 * Run once from the Apps Script editor (select "setup" and click Run).
 * Creates the private data folder, seeds the event content and generates an admin passcode.
 * Safe to run again: it only creates what is missing and prints the current details.
 */
function setup() {
  var ids = ensureSetup_();
  var p = props_();
  if (!p.getProperty('ADMIN_PASSCODE')) p.setProperty('ADMIN_PASSCODE', randomToken_().slice(0, 20));
  refreshCache();
  var url = webAppUrl_();
  console.log([
    'Tech Tank is ready.',
    'Admin passcode: ' + p.getProperty('ADMIN_PASSCODE') + '   (change it in Project Settings > Script properties > ADMIN_PASSCODE)',
    'Data folder: https://drive.google.com/drive/folders/' + ids.folder,
    'Registrations sheet: https://docs.google.com/spreadsheets/d/' + ids.sheet,
    url ? 'Web app: ' + url + '   (Control Room: ' + url + '?page=admin)' : 'Next: Deploy > New deployment > Web app (Execute as: Me, Who has access: Anyone).',
  ].join('\n'));
}

/** Run after editing content.json or participants.private.json directly in Drive. */
function refreshCache() {
  var cache = CacheService.getScriptCache();
  ['content', 'private'].forEach(function (kind) { cache.remove(kind + ':n'); });
  bumpWake_();
}

function ensureSetup_() {
  var p = props_();
  var ids = storedIds_();
  if (ids.complete) return ids;
  return withLock_(function () {
    ids = storedIds_();
    if (ids.complete) return ids;
    var folder = ids.folder ? DriveApp.getFolderById(ids.folder) : DriveApp.createFolder('Tech Tank Hackathon data');
    p.setProperty('DATA_FOLDER_ID', folder.getId());
    if (!ids.content) {
      var seed = JSON.parse(JSON.stringify(SEED_CONTENT_));
      p.setProperty('CONTENT_FILE_ID', folder.createFile('content.json', JSON.stringify(seed, null, 2), 'application/json').getId());
    }
    if (!ids.backup) p.setProperty('BACKUP_FILE_ID', folder.createFile('content.backup.json', '{}', 'application/json').getId());
    if (!ids.private) p.setProperty('PRIVATE_FILE_ID', folder.createFile('participants.private.json', JSON.stringify({ users: [], sessions: [] }), 'application/json').getId());
    if (!ids.proofs) p.setProperty('PROOF_FOLDER_ID', folder.createFolder('payment-proofs').getId());
    if (!ids.media) p.setProperty('MEDIA_FOLDER_ID', folder.createFolder('media').getId());
    if (!ids.sheet) {
      var book = SpreadsheetApp.create('Tech Tank registrations');
      var sheet = book.getSheets()[0].setName('Registrations');
      sheet.appendRow(REG_HEADERS_);
      sheet.setFrozenRows(1);
      DriveApp.getFileById(book.getId()).moveTo(folder);
      p.setProperty('SHEET_ID', book.getId());
    }
    return storedIds_();
  });
}

function storedIds_() {
  var all = props_().getProperties();
  var ids = {
    folder: all.DATA_FOLDER_ID, content: all.CONTENT_FILE_ID, backup: all.BACKUP_FILE_ID, private: all.PRIVATE_FILE_ID,
    proofs: all.PROOF_FOLDER_ID, media: all.MEDIA_FOLDER_ID, sheet: all.SHEET_ID,
  };
  ids.complete = !!(ids.folder && ids.content && ids.backup && ids.private && ids.proofs && ids.media && ids.sheet);
  return ids;
}

/* ============================== storage ============================== */

function props_() { return PropertiesService.getScriptProperties(); }

function withLock_(fn) {
  var lock = LockService.getScriptLock();
  try { lock.waitLock(25000); } catch (err) { throw httpError_(503, 'The website is busy. Please try again in a moment.'); }
  try { return fn(); } finally { lock.releaseLock(); }
}

// CacheService values are limited to 100 KB, so larger JSON is stored in pieces.
var CACHE_CHUNK_ = 30000; // characters; stays under 100 KB even for multi-byte text
function cacheGet_(key) {
  var cache = CacheService.getScriptCache();
  var n = Number(cache.get(key + ':n'));
  if (!n) return null;
  var keys = [];
  for (var i = 0; i < n; i++) keys.push(key + ':' + i);
  var parts = cache.getAll(keys);
  var text = '';
  for (var j = 0; j < n; j++) { if (parts[keys[j]] == null) return null; text += parts[keys[j]]; }
  return text;
}
function cachePut_(key, text) {
  var values = {}, n = Math.max(1, Math.ceil(text.length / CACHE_CHUNK_));
  for (var i = 0; i < n; i++) values[key + ':' + i] = text.slice(i * CACHE_CHUNK_, (i + 1) * CACHE_CHUNK_);
  try {
    var cache = CacheService.getScriptCache();
    cache.remove(key + ':n'); // readers fall back to Drive while pieces are replaced
    cache.putAll(values, TT_CACHE_SECONDS);
    cache.put(key + ':n', String(n), TT_CACHE_SECONDS);
  } catch (err) { console.warn('Cache unavailable: ' + err); }
}

function readJson_(kind, fresh) {
  if (!fresh) {
    var cached = cacheGet_(kind);
    if (cached) { try { return JSON.parse(cached); } catch (err) { /* read the file below */ } }
  }
  var ids = ensureSetup_();
  var text = DriveApp.getFileById(ids[kind]).getBlob().getDataAsString('UTF-8');
  var data = JSON.parse(text);
  cachePut_(kind, text);
  return data;
}
function writeJson_(kind, data, pretty) {
  var text = JSON.stringify(data, null, pretty ? 2 : 0);
  DriveApp.getFileById(ensureSetup_()[kind]).setContent(text);
  cachePut_(kind, text);
}

function readContent_() { return readJson_('content'); }
function readPrivate_(fresh) {
  var data = readJson_('private', fresh);
  data.users = data.users || [];
  data.sessions = data.sessions || [];
  return data;
}
function savePrivate_(data) {
  var now = Date.now();
  data.sessions = data.sessions.filter(function (s) { return s.expiresAt > now; });
  writeJson_('private', data);
}

function writeContent_(obj) {
  var ids = ensureSetup_();
  return withLock_(function () {
    obj.updatedAt = new Date().toISOString();
    // Keep the previous publish as a backup (at most every 30 seconds while auto-publishing).
    var cache = CacheService.getScriptCache();
    if (!cache.get('backup-recent')) {
      try {
        DriveApp.getFileById(ids.backup).setContent(DriveApp.getFileById(ids.content).getBlob().getDataAsString('UTF-8'));
        cache.put('backup-recent', '1', 30);
      } catch (err) { console.warn('Backup skipped: ' + err); }
    }
    writeJson_('content', obj, true);
    return obj;
  });
}

// Wakes open participant portals after a private account change.
function bumpWake_() { props_().setProperty('WAKE', String(Date.now())); }

/* ============================== public content ============================== */

// The question stays sealed for the public until its reveal time (or until the admin reveals it).
function isSealed_(q) { return !!q && !q.revealed && !(q.revealAt && Date.now() >= Date.parse(q.revealAt)); }
function isTwistSealed_(c) { return !!c && c.published === false || isSealed_(c || {}); }
function cardTopic_(m) {
  if (m.topic) return m.topic;
  if (/sample-crisis-card/i.test(m.url || '')) return 'twist';
  if (/sample-theme/i.test(m.url || '')) return 'theme';
  if (/sample-campaign/i.test(m.url || '')) return 'campaign';
  return 'media';
}
function publicContent_(raw) {
  var obj = JSON.parse(JSON.stringify(raw));
  var q = obj.question || {};
  obj.question = isSealed_(q) ? { sealed: true, revealAt: q.revealAt || '', sample: !!q.sample } : assign_({}, q, { sealed: false });
  var c = obj.crisis || {};
  var sealed = isTwistSealed_(c);
  obj.crisis = sealed ? { title: 'The twist', intro: '', tests: [], revealAt: c.published === false ? '' : c.revealAt || '', sealed: true }
    : { title: c.title || 'The twist', intro: c.intro || '', tests: c.tests || [], revealAt: c.revealAt || '', sealed: false, statement: c.statement || '' };
  obj.media = (obj.media || []).map(function (m) {
    var topic = cardTopic_(m);
    return topic === 'twist' && sealed ? { id: m.id, topic: topic, locked: true, caption: 'The twist · Locked', type: 'image', url: '' } : assign_({}, m, { topic: topic, locked: false });
  });
  // Team assignments and unpublished scores never reach the public.
  var published = !!(obj.results && obj.results.published);
  obj.teams = (obj.teams || []).map(function (t) {
    var team = assign_({}, t);
    delete team.crisisCard; delete team.members; delete team.project; delete team.scores;
    if (published) team.scores = t.scores;
    return team;
  });
  if (!published) obj.results = { published: false };
  return obj;
}
function publicSnapshot_(raw) {
  var version = [raw.updatedAt || '', isSealed_(raw.question) ? 1 : 0, isTwistSealed_(raw.crisis) ? 1 : 0, props_().getProperty('WAKE') || ''].join('|');
  return { version: version, content: publicContent_(raw) };
}

/* ============================== API ============================== */

/**
 * Single entry point used by the pages (through google.script.run).
 * req: { method, path, query, body, passcode, token }. Returns { status, json } or { status, base64, contentType }.
 */
function api(req) {
  try {
    req = req || {};
    ensureSetup_(); // completes first-run storage before any request takes the write lock
    var r = {
      method: String(req.method || 'GET').toUpperCase(),
      path: String(req.path || ''),
      query: req.query && typeof req.query === 'object' ? req.query : {},
      body: req.body == null ? '' : req.body,
      passcode: typeof req.passcode === 'string' ? req.passcode : '',
      token: typeof req.token === 'string' ? req.token : '',
    };
    return route_(r);
  } catch (err) {
    if (err && err.status) return reply_(err.status, { error: err.message });
    console.error(err && err.stack ? err.stack : err);
    return reply_(500, { error: 'Could not complete the request. Please try again.' });
  }
}

function route_(req) {
  var p = req.path, m = req.method;
  if (p === '/api/stream' && m === 'GET') {
    var snap = publicSnapshot_(readContent_());
    return reply_(200, snap.version === String(req.query.since || '') ? { version: snap.version } : snap);
  }
  if (p === '/api/content' && m === 'GET') {
    var raw = readContent_();
    return reply_(200, isAdmin_(req) ? raw : publicContent_(raw));
  }
  if (p === '/api/login' && m === 'POST') {
    if (!props_().getProperty('ADMIN_PASSCODE')) return reply_(401, { error: 'The admin passcode is not set yet. Run setup() in the Apps Script editor.' });
    return isAdmin_(req) ? reply_(200, { ok: true }) : reply_(401, { error: 'Wrong passcode' });
  }
  if (p === '/api/content' && m === 'PUT') {
    if (!isAdmin_(req)) return reply_(401, { error: 'Wrong passcode' });
    var obj = parseBody_(req, 5 * 1024 * 1024);
    if (!obj || typeof obj !== 'object' || !obj.event) return reply_(400, { error: 'Content must include "event"' });
    if (obj.portal) {
      var demo = Number(obj.portal.demoMinutes), qa = Number(obj.portal.qaMinutes);
      if (!isFinite(demo) || demo <= 0 || demo > 180 || !isFinite(qa) || qa < 0 || qa > 60) {
        return reply_(400, { error: 'Presentation time must be between 1 and 180 minutes; Q&A must be between 0 and 60 minutes' });
      }
    }
    return reply_(200, writeContent_(obj));
  }
  if (p === '/api/upload' && m === 'POST') {
    if (!isAdmin_(req)) return reply_(401, { error: 'Wrong passcode' });
    return uploadMedia_(req);
  }
  if (p === '/api/payment-proof' && m === 'GET') {
    if (!isAdmin_(req)) return reply_(401, { error: 'Admin sign-in required' });
    var owner = findUser_(readPrivate_(), String(req.query.id || ''));
    if (!owner || !owner.payment || !owner.payment.proofFileId) return reply_(404, { error: 'Payment proof not found' });
    var proof = DriveApp.getFileById(owner.payment.proofFileId).getBlob();
    return { status: 200, base64: Utilities.base64Encode(proof.getBytes()), contentType: owner.payment.proofType };
  }
  if (p === '/api/participants') {
    if (!isAdmin_(req)) return reply_(401, { error: 'Admin sign-in required' });
    if (m === 'GET') return reply_(200, { users: readPrivate_().users.map(safeUser_) });
    if (m === 'PUT') return updateParticipant_(req);
  }
  if (p === '/api/account' && m === 'GET') {
    var me = currentUser_(req);
    return me ? reply_(200, { user: safeUser_(me) }) : reply_(401, { error: 'Please sign in' });
  }
  if (p === '/api/portal' && m === 'GET') return portal_(req);
  if (p === '/api/account/logout' && m === 'POST') {
    if (/^[a-f0-9]{64}$/.test(req.token)) {
      var tokenHash = sha256Hex_(req.token);
      withLock_(function () {
        var data = readPrivate_(true);
        var before = data.sessions.length;
        data.sessions = data.sessions.filter(function (s) { return s.tokenHash !== tokenHash; });
        if (data.sessions.length !== before) savePrivate_(data);
      });
    }
    return reply_(200, { ok: true });
  }
  if (m === 'POST' && (p === '/api/account/register' || p === '/api/account/login')) return p === '/api/account/register' ? register_(req) : login_(req);
  if (/^\/api\//.test(p)) return reply_(405, { error: 'Method not allowed' });
  return reply_(404, { error: 'Not found' });
}

function reply_(status, body) { return { status: status, json: JSON.stringify(body) }; }
function httpError_(status, message) { var e = new Error(message); e.status = status; return e; }
function parseBody_(req, limit) {
  if (req.body && typeof req.body === 'object') return req.body;
  var text = String(req.body || '');
  if (text.length > limit) throw httpError_(413, 'The request is too large.');
  try { return JSON.parse(text); } catch (err) { throw httpError_(400, 'Invalid request'); }
}
function clean_(value, max) { return typeof value === 'string' ? value.trim().slice(0, max) : ''; }

function isAdmin_(req) {
  var real = props_().getProperty('ADMIN_PASSCODE');
  return !!real && safeEqual_(String(req.passcode || ''), real);
}

/* ---------- media ---------- */

function uploadMedia_(req) {
  var original = String(req.query.name || 'file');
  var ext = (/\.([a-z0-9]+)$/i.exec(original) || [])[1];
  ext = ext ? ext.toLowerCase() : '';
  var type = TT_UPLOAD_TYPES[ext];
  if (!type) return reply_(400, { error: 'Unsupported file type .' + ext });
  var input = parseBody_(req, Math.ceil(TT_MAX_UPLOAD * 4 / 3) + 4096);
  var data = typeof input.data === 'string' ? input.data.replace(/^data:[^,]*,/, '') : '';
  if (!data || !/^[A-Za-z0-9+/]+={0,2}$/.test(data)) return reply_(400, { error: 'The file could not be read. Please choose it again.' });
  if (data.length > Math.ceil(TT_MAX_UPLOAD * 4 / 3) + 4) return reply_(413, { error: 'Files up to 20 MB can be uploaded here. Add larger videos by YouTube or Google Drive link.' });
  var bytes = Utilities.base64Decode(data);
  var base = original.replace(/\.[^.]*$/, '').replace(/[^a-z0-9_-]+/gi, '-').slice(0, 40) || 'media';
  var file = DriveApp.getFolderById(ensureSetup_().media).createFile(Utilities.newBlob(bytes, type, Date.now().toString(36) + '-' + base + '.' + ext));
  var shared = true;
  try { file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW); } catch (err) { shared = false; }
  var id = file.getId();
  var url = /^video\//.test(type) ? 'https://drive.google.com/file/d/' + id + '/preview' : 'https://lh3.googleusercontent.com/d/' + id;
  return reply_(200, { url: url, driveId: id, shared: shared });
}

/* ---------- participants ---------- */

var REG_HEADERS_ = ['Registration ID', 'Registered at', 'Name', 'Email', 'Team', 'Amount INR', 'Transaction ID', 'Payment status', 'Proof URL', 'Account status', 'Linked team', 'Organiser note'];

function safeUser_(u) {
  var out = { id: u.id, name: u.name, email: u.email, teamName: u.teamName, teamId: u.teamId, status: u.status, note: u.note, createdAt: u.createdAt };
  if (u.payment) out.payment = { amount: u.payment.amount, transactionId: u.payment.transactionId, status: u.payment.status, proofUrl: '/api/payment-proof?id=' + encodeURIComponent(u.id) };
  return out;
}
function findUser_(data, id) {
  for (var i = 0; i < data.users.length; i++) if (data.users[i].id === id) return data.users[i];
  return null;
}
function currentUser_(req, data) {
  if (!/^[a-f0-9]{64}$/.test(req.token || '')) return null;
  data = data || readPrivate_();
  var tokenHash = sha256Hex_(req.token), now = Date.now();
  for (var i = 0; i < data.sessions.length; i++) {
    var s = data.sessions[i];
    if (s.tokenHash === tokenHash && s.expiresAt > now) return findUser_(data, s.userId);
  }
  return null;
}
function newSession_(data, user) {
  var token = randomToken_();
  data.sessions.push({ tokenHash: sha256Hex_(token), userId: user.id, expiresAt: Date.now() + TT_SESSION_MS });
  return token;
}
// No client IP is available in Apps Script, so attempts are limited per email address.
function limited_(key) {
  var cache = CacheService.getScriptCache();
  var k = 'rl:' + sha256Hex_(key).slice(0, 40);
  var count = Number(cache.get(k) || 0) + 1;
  cache.put(k, String(count), 900);
  return count > 30;
}

function register_(req) {
  var input = parseBody_(req, 7 * 1024 * 1024 + 16384);
  var email = clean_(input.email, 254).toLowerCase();
  var password = typeof input.password === 'string' ? input.password : '';
  if (limited_('register:' + email)) return reply_(429, { error: 'Too many attempts. Please try again in 15 minutes.' });
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || password.length > 128 || !password) return reply_(400, { error: 'Enter a valid email and password' });
  var event = readContent_().event || {};
  if (event.registrationOpen === false || Date.now() >= Date.parse(event.registrationDeadline)) {
    return reply_(403, { error: 'Registration is closed. Existing participants can still sign in.' });
  }
  var name = clean_(input.name, 100), teamName = clean_(input.teamName, 100);
  if (!name || !teamName || password.length < 10) return reply_(400, { error: 'Enter your name, team name, and a password of at least 10 characters' });
  var transactionId = clean_(input.transactionId, 100);
  var proof = typeof input.paymentProof === 'string' && /^data:(image\/(?:png|jpeg|webp));base64,([A-Za-z0-9+/]+={0,2})$/.exec(input.paymentProof);
  if (!transactionId || !proof) return reply_(400, { error: 'Enter your transaction ID and upload payment proof for ₹150' });
  var bytes = Utilities.base64Decode(proof[2]);
  if (!validImage_(proof[1], bytes) || bytes.length > TT_MAX_PROOF) return reply_(400, { error: 'Choose a PNG, JPG or WebP payment screenshot up to 5 MB' });
  if (readPrivate_().users.some(function (u) { return u.email === email; })) return reply_(409, { error: 'An account with this email already exists. Please sign in.' });

  var salt = randomToken_().slice(0, 32);
  var user = {
    id: Utilities.getUuid(), name: name, email: email, teamName: teamName, teamId: '', status: 'registered', note: '',
    createdAt: new Date().toISOString(), salt: salt, passwordHash: passwordHash_(password, salt, TT_HASH_ROUNDS), hashRounds: TT_HASH_ROUNDS,
  };
  var ext = { 'image/png': 'png', 'image/jpeg': 'jpg', 'image/webp': 'webp' }[proof[1]];
  var proofFile = DriveApp.getFolderById(ensureSetup_().proofs).createFile(Utilities.newBlob(bytes, proof[1], user.id + '.' + ext));
  user.payment = { amount: 150, transactionId: transactionId, status: 'pending-review', proofFileId: proofFile.getId(), proofType: proof[1] };
  var token = withLock_(function () {
    // Re-read inside the lock: concurrent registrations must not overwrite each other.
    var data = readPrivate_(true);
    if (data.users.some(function (u) { return u.email === email; })) return null;
    data.users.push(user);
    var t = newSession_(data, user);
    savePrivate_(data);
    return t;
  });
  if (!token) {
    try { proofFile.setTrashed(true); } catch (err) { /* left in the private folder */ }
    return reply_(409, { error: 'An account with this email already exists. Please sign in.' });
  }
  try { appendRegistration_(user, proofFile.getUrl()); } catch (err) { console.warn('Registrations sheet not updated: ' + err); }
  return { status: 201, json: JSON.stringify({ user: safeUser_(user) }), token: token };
}

function login_(req) {
  var input = parseBody_(req, 16384);
  var email = clean_(input.email, 254).toLowerCase();
  var password = typeof input.password === 'string' ? input.password : '';
  if (limited_('login:' + email)) return reply_(429, { error: 'Too many attempts. Please try again in 15 minutes.' });
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || password.length > 128 || !password) return reply_(400, { error: 'Enter a valid email and password' });
  var found = null;
  readPrivate_().users.forEach(function (u) { if (u.email === email) found = u; });
  // Hash even when the account is missing, to avoid a fast account-existence check.
  var hash = passwordHash_(password, found ? found.salt : 'missing-account-salt', found ? found.hashRounds || TT_HASH_ROUNDS : TT_HASH_ROUNDS);
  if (!found || !safeEqual_(hash, found.passwordHash)) return reply_(401, { error: 'Email or password is incorrect' });
  var result = withLock_(function () {
    var data = readPrivate_(true);
    var user = findUser_(data, found.id);
    if (!user) return null;
    var t = newSession_(data, user);
    savePrivate_(data);
    return { token: t, user: safeUser_(user) };
  });
  if (!result) return reply_(401, { error: 'Email or password is incorrect' });
  return { status: 200, json: JSON.stringify({ user: result.user }), token: result.token };
}

function portal_(req) {
  var user = currentUser_(req);
  if (!user) return reply_(401, { error: 'Please sign in' });
  var raw = readContent_();
  var content = publicContent_(raw);
  var team = null;
  (raw.teams || []).forEach(function (t) { if (t.id === user.teamId) team = t; });
  var published = !!(raw.results && raw.results.published);
  var result = { published: published, team: team ? team.name : user.teamName, linked: !!team };
  if (team && published) {
    var total = function (t) {
      return Math.round((raw.judging || []).reduce(function (sum, j) { return sum + (Number((t.scores || {})[j.name]) || 0) / 10 * (Number(j.weight) || 0); }, 0) * 10) / 10;
    };
    var mine = total(team);
    result.total = mine;
    result.rank = 1 + (raw.teams || []).filter(function (t) { return total(t) > mine; }).length;
    result.scores = team.scores || {};
    result.awards = ((raw.results && raw.results.winners) || []).filter(function (w) { return w.team === team.name; }).map(function (w) { return w.award; });
  }
  var assignedTwist = null;
  if (!content.crisis.sealed && team) {
    ((raw.crisis && raw.crisis.cards) || []).forEach(function (card) { if (!assignedTwist && card.title === team.crisisCard) assignedTwist = card; });
  }
  return reply_(200, { user: safeUser_(user), content: content, result: result, assignedTwist: assignedTwist });
}

function updateParticipant_(req) {
  var input = parseBody_(req, 16384);
  if (TT_STATUSES.indexOf(input.status) < 0) return reply_(400, { error: 'Choose a valid status' });
  var content = readContent_();
  if (input.teamId && !(content.teams || []).some(function (t) { return t.id === input.teamId; })) return reply_(400, { error: 'Choose an existing team' });
  var saved = withLock_(function () {
    var data = readPrivate_(true);
    var user = findUser_(data, input.id);
    if (!user) return null;
    user.teamId = clean_(input.teamId, 100);
    user.status = input.status;
    user.note = clean_(input.note, 2000);
    savePrivate_(data);
    return user;
  });
  if (!saved) return reply_(404, { error: 'Participant not found' });
  bumpWake_(); // open portals fetch the private update through their session
  try {
    var team = null;
    (content.teams || []).forEach(function (t) { if (t.id === saved.teamId) team = t; });
    updateRegistration_(saved, team ? team.name : '');
  } catch (err) { console.warn('Registrations sheet not updated: ' + err); }
  return reply_(200, safeUser_(saved));
}

function validImage_(type, bytes) {
  var b = function (i) { return bytes[i] & 255; };
  if (!bytes.length) return false;
  if (type === 'image/png') return [137, 80, 78, 71, 13, 10, 26, 10].every(function (v, i) { return b(i) === v; });
  if (type === 'image/jpeg') return b(0) === 255 && b(1) === 216 && b(2) === 255;
  var ascii = function (from, to) { var s = ''; for (var i = from; i < to; i++) s += String.fromCharCode(b(i)); return s; };
  return bytes.length > 12 && ascii(0, 4) === 'RIFF' && ascii(8, 12) === 'WEBP';
}

/* ---------- registrations spreadsheet (for organisers) ---------- */

function registrationSheet_() {
  var book = SpreadsheetApp.openById(ensureSetup_().sheet);
  var sheet = book.getSheetByName('Registrations') || book.insertSheet('Registrations');
  if (!sheet.getLastRow()) sheet.appendRow(REG_HEADERS_);
  return sheet;
}
function cell_(value) {
  // Participant text must never become a spreadsheet formula.
  var text = String(value == null ? '' : value);
  return /^[\s]*[=+@-]/.test(text) ? "'" + text : text;
}
function appendRegistration_(user, proofUrl) {
  var sheet = registrationSheet_();
  sheet.appendRow([user.id, user.createdAt, cell_(user.name), cell_(user.email), cell_(user.teamName), 150, "'" + String(user.payment.transactionId),
    'pending-review', proofUrl, user.status, '', '']);
}
function updateRegistration_(user, teamName) {
  var sheet = registrationSheet_();
  if (sheet.getLastRow() < 2) return;
  var hit = sheet.getRange(2, 1, sheet.getLastRow() - 1, 1).createTextFinder(user.id).matchEntireCell(true).findNext();
  if (hit) sheet.getRange(hit.getRow(), 10, 1, 3).setValues([[user.status, cell_(teamName), cell_(user.note)]]);
}

/* ============================== crypto helpers ============================== */

function bytesToHex_(bytes) {
  var out = '';
  for (var i = 0; i < bytes.length; i++) out += ((bytes[i] & 255) + 256).toString(16).slice(1);
  return out;
}
function sha256Hex_(text) { return bytesToHex_(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(text), Utilities.Charset.UTF_8)); }
function randomToken_() { return (Utilities.getUuid() + Utilities.getUuid()).replace(/-/g, '').toLowerCase(); }
function safeEqual_(a, b) {
  a = String(a); b = String(b);
  var diff = a.length ^ b.length;
  for (var i = 0; i < Math.max(a.length, b.length); i++) diff |= (a.charCodeAt(i) || 0) ^ (b.charCodeAt(i) || 0);
  return diff === 0;
}
/** PBKDF2-HMAC-SHA256 with a 32-byte key (RFC 8018), using the built-in HMAC. */
function passwordHash_(password, salt, rounds) {
  var key = Utilities.newBlob(String(password)).getBytes();
  var block = Utilities.newBlob(String(salt)).getBytes().concat([0, 0, 0, 1]);
  var u = Utilities.computeHmacSha256Signature(block, key);
  var t = u.slice();
  for (var i = 1; i < rounds; i++) {
    u = Utilities.computeHmacSha256Signature(u, key);
    for (var j = 0; j < t.length; j++) t[j] ^= u[j];
  }
  return bytesToHex_(t);
}

/* ============================== small helpers ============================== */

function assign_(target) {
  for (var i = 1; i < arguments.length; i++) {
    var src = arguments[i];
    if (src) for (var k in src) if (Object.prototype.hasOwnProperty.call(src, k)) target[k] = src[k];
  }
  return target;
}
function escapeHtml_(value) {
  return String(value).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; });
}
// JSON that is safe inside an inline <script> element.
function scriptJson_(value) {
  var lineSep = String.fromCharCode(0x2028), paraSep = String.fromCharCode(0x2029);
  return JSON.stringify(value).replace(/</g, '\\u003c').split(lineSep).join('\\u2028').split(paraSep).join('\\u2029');
}
