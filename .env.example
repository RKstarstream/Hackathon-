# Reference only: set these in your host dashboard or terminal.
# The server does not automatically load .env files.
PORT=3000
ADMIN_PASSCODE=replace-with-a-private-passcode
# Enable when deploying behind HTTPS.
COOKIE_SECURE=1
# Optional Google Apps Script integration (leave both empty to disable).
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
